{##
 # main menu
 #}

<nav id="mainMenu">

	{# logo #}
	<div id="logo">
		<a href="/" aria-label="Home"></a>
	</div>

	{# spacer #}
	{# <div class="spacer" /> #}

	{# search #}
	<div id="searchForm">
		<form id="universalSearch" name="universalSearch" method="get" action="/universalSearch">

			{# workaround for some endpoints that need &action=search #}
			<input type="hidden" name="action" value="search">

			{# the universal search bar itself #}
			<input type="text" id="search" name="search" placeholder="Search for anything">

			{# select which site area to search #}
			<select id="searchWhat" name="searchWhat">
				<option value="torrents" selected>Torrents</option>
				<option value="collages">Collages</option>
				<option value="requests">Requests</option>

				<option value="creators">Creators</option>
				<option value="literature">Literature</option>
				<option value="publications">Publications</option>
				<option value="organizations">Organizations</option>

				{#
				<option value="wiki">Wiki</option>
				<option value="log">Log</option>
				#}
			</select>

			{# submit button, maybe unnecessary #}
			{# <input type="submit" class="button-primary" value="go"> #}
		</form>
	</div>

	{# hamburger icon #}
	<div id="hamburger">
		<a id="toggleIcon">
			<i class="fal fa-bars"></i>
		</a>
	</div>

</nav> {# mainMenu #}


