{##
 # user info
 #}

<nav id="userInfo">
    
    {# stats #}
    <ul>

        {# seeding #}
        <li>
            <a href="/torrents.php?type=seeding&userid={{ user.core.id }}" class="tooltip conversationButton" title="Seeding">
                <i class="fa-thin fa-cloud-arrow-up"></i>
            </a>
            <span class="stat tooltip" title="{{ user.extra.Uploaded|get_size(levels = 5) }}">
                {{ user.extra.Uploaded|get_size }}
            </span>
        </li>

        {# leeching #}
        <li>
            <a href="/torrents.php?type=leeching&userid={{ user.core.id }}" class="tooltip conversationButton" title="Leeching">
                <i class="fa-thin fa-cloud-arrow-down"></i>
            </a>
            <span class="stat tooltip" title="{{ user.extra.Downloaded|get_size(levels = 5) }}">
                {{ user.extra.Downloaded|get_size }}
            </span>
        </li>

        {# ratio #}
        <li>
            <a href="/rules/ratio" class="tooltip conversationButton" title="Ratio">
                <i class="fa-thin fa-percent"></i>
            </a>
            <span class="stat">
                {{ ratio(user.extra.Uploaded, user.extra.Downloaded) }}
            </span>
        </li>

        {# required ratio #}
        {% if user.extra.RequiredRatio and user.extra.RequiredRatio > 0 %}
        <li>
            <a href="/rules/ratio" class="tooltip conversationButton" title="Required ratio">
                Required
            </a>
            <span class="stat tooltip" title="{{ user.extra.RequiredRatio|float(decimals = 5) }}">
                {{ user.extra.RequiredRatio|float }}
            </span>
        </li>
        {% endif %}

        {# freeleech tokens #}
        {% if user.extra.FLTokens > 0 %}
        <li id="fl_tokens">
            <a href="/wiki/tokens" class="tooltip conversationButton" title="Freeleech tokens">
                <i class="fa-thin fa-ticket"></i>
            </a>
            <span class="stat">
                <a href="/userhistory.php?action=token_history&userid={{ user.core.id }}">
                    {{ user.extra.FLTokens }}
                </a>
            </span>
        </li>
        {% endif %}

        {# bonus points #}
        <li id="bonus_points">
            <a href="/store" class="tooltip conversationButton" title="{{ env.bonusPoints }}">
                <i class="fa-thin fa-cart-shopping"></i>
            </a>
            <span class="stat">
                {{ user.extra.BonusPoints|number_format }}
            </span>
        </li>

        {# hit and runs #}
        {% if user.extra.HnR > 0 %}
        <li id="hnr">
            <a href="/snatchlist.php" class="tooltip conversationButton" title="HnRs">
                <i class="fa-thin fa-car-bolt"></i>
            </a>
            <span class="stat">
                {{ user.extra.HnR }}
            </span>
        </li>
        {% endif %}

    </ul>

</nav>