{##
 # link a site object with one or more others
 #}

<section>
    <h3>Add related items</h3>

    <form method="post" action="/link-objects">
        {{ form_token("link-objects") }}

        {# the object to link to #}
        <select id="searchContext" class="select" placeholder="Select a content type">
            <option value="">Select a content type</option>
            <option value="collages">Collages</option>
            <option value="creators">Creators</option>
            <option value="literature">Literature</option>
            <option value="organizations">Organizations</option>
            <option value="publications">Publications</option>
            <option value="requests">Requests</option>
            <option value="torrentGroups">Torrent groups</option>
        </select>

        {# the search input #}
        <input type="text" id="linkObjects" class="typeahead" style="width: 100%;" placeholder="Search local and remote">

        {# what index to autocomplete on #}
        <input type="hidden" name="index">

        {# the selected objects #}
        <select id="selectedLinks" name="selectedLinks" class="select" multiple>
            <option value="">Your linked item suggestions</option>
        </select>

        {# hidden fields for the different types of objects #}
        {#
        <input type="hidden" name="collages[]">
        <input type="hidden" name="creators[]">
        <input type="hidden" name="literature[]">
        <input type="hidden" name="organizations[]">
        <input type="hidden" name="publications[]">
        <input type="hidden" name="requests[]">
        <input type="hidden" name="torrentGroups[]">
        #}

        {# submit button #}
        <input type="submit" class="button-primary" value="link items">
    </form>

    <script>
        (() => {
            "use strict";

            // create the data source
            var bloodhound = new Bloodhound({
                datumTokenizer: Bloodhound.tokenizers.whitespace,
                queryTokenizer: Bloodhound.tokenizers.whitespace,
                remote: {
                    url: "/api/internal/autocomplete",
                    prepare: function (query, settings) {
                        settings.url += "?query=" + query + "&context=" + $("#searchContext").val();
                        return settings;
                    },
                    transform: function (response) {
                        return response.data;
                    },
                }
            });

            // create the typeahead
            $("#linkObjects").typeahead({
                hint: true,
                highlight: true,
                minLength: 3
            }, {
                name: "bloodhound",
                source: bloodhound,
                templates: {
                    suggestion: function (item) {
                        let localOrRemote = item.isLocal ? "localResult" : "remoteResult";
                        return "<div class='typeaheadResult "
                            + localOrRemote
                            + "' data-id='"
                            + item.id
                            + "' data-openalexid='"
                            + item.openAlexId + "'>"
                            + item.text + "</div>";
                    },
                }
            });

            // handle the user clicking a suggestion
            $("#linkObjects").on("typeahead:select", function(e, selected) {
                // https://tom-select.js.org/docs/api/
                let select = document.getElementById("selectedLinks");
                let control = select.tomselect;
                let optionId = JSON.stringify(selected);

                control.addOption({
                    value: optionId,
                    text: selected.text
                }, true); // user_created
                control.addItem(optionId);

                // https://github.com/twitter/typeahead.js/issues/233
                $("#linkObjects").typeahead("val", "");
            });

        })();
        </script>
</section>
