{# cover art #}
<section>

	{% if torrentGroup.attributes.picture is not empty and user.siteOptions.coverArtTorrents == true %}
		{% set uri = processImage(torrentGroup.attributes.picture, "thumb") %}
	{% else %}
		{% set uri = processImage("/images/noartwork.webp", "thumb") %}
	{% endif %}

	<figure id="groupPicture" class="box_image box_image_albumart box_albumart">
		<img src="{{ uri }}" lightbox-img="{{ uri }}" alt="{{ torrentGroup.attributes.title }}" title="{{ torrentGroup.attributes.title }}">
	</figure>

</section>


{# actions #}
<section>
	<h3>Actions</h3>

	<form>
        {# add new torrent #}
		<a class="button button-green" href="/upload.php?groupid={{ torrentGroup.id }}">add new format</a>

{#
		{# add new request # }
		{% if can({"requests": "create"}) %}
			<a class="button button-green" href="/requests.php?action=new&groupid={{ torrentGroup.id }}">new request</a>
		{% endif %}
#}

		{# toggle bookmark #}
		{% if isBookmarked %}
			<a class="button button-red" id="toggleGroupBookmark" data-userid="{{ user.core.id }}" data-groupid="{{ torrentGroup.id }}">remove bookmark</a>
		{% else %}
			<a class="button button-orange" id="toggleGroupBookmark" data-userid="{{ user.core.id }}" data-groupid="{{ torrentGroup.id }}">add bookmark</a>
		{% endif %}

		<hr />

		{# edit group #}
		{% if can({"torrentGroups": "update"}) %}
			<a class="button button-primary" href="/torrent-groups/{{ torrentGroup.id }}/edit">edit group</a>
		{% endif %}

		{# use this revision #}
		{% if revisionId != 0 and can({"torrentGroups": "update"}) %}
			<a class="button button-orange" href="/torrents.php?action=revert&groupid={{ torrentGroup.id }}&revisionid={{ revisionId }}">use this revision</a>
		{% endif %}

		{# revision history #}
		<a class="button" href="/torrents.php?action=history&groupid={{ torrentGroup.id }}">revision history</a>

		{# view log #}
		<a class="button" href="/torrents.php?action=grouplog&groupid={{ torrentGroup.id }}">view log</a>

	</form>

</section>


{# creators #}
<section>
<span id="creatorListHeader">
<h3>Creators</h3>
<a class="button button-orange">edit</a>
</span>

<table class="compact">

{% for item in torrentGroup.relationships.creators %}
<tr>
<th><a href="/creators/{{ item.id }}">{{ item.attributes.name }}</a></th>

<td class="right">
{% if can({"torrentGroups": "update", "creators": "delete"}) %}
	<a id="deleteCreatorFromTorrent" class="conversationButton tooltip" title="delete" data-creatorid={{ item.id }}>
		<i class="fa-thin fa-trash" data-creatorid={{ item.id }}></i>
	</a>
{% endif %}
</td>
</tr>
{% endfor %}

</table>

{# add new #}
{% if can({"torrentGroups": "update", "creators": "create"}) %}
<form>
<input type="hidden" name="torrentGroup.id" value="{{ torrentGroup.id }}">

<input type="text" id="creatorName" placeholder="e.g., {{ randomCreator() }}">

<a class="button button-primary" id="addNewCreator">new creator</a>
</form>
{% endif %}
</section>


{# tags #}
<section>
<h3>Tags</h3>

<table class="compact">

{# normal tags #}
{% for item in torrentGroup.relationships.tags %}
{% if item.attributes.tagType != "openai" %}
<tr>

<th>{{ item.attributes.name }}</th>

<td class="right">
{% if can({"torrentGroups": "update", "tags": "delete"}) %}
	<a id="deleteGroupTag" class="conversationButton tooltip deleteGroupTag" title="delete" data-tagid={{ item.id }} data-groupid={{ torrentGroup.id }}>
		<i class="fa-thin fa-trash" data-tagid={{ item.id }} data-groupid={{ torrentGroup.id }}></i>
	</a>
{% endif %}

</td>
</tr>
{% endif %}
{% endfor %}

{# openai tags #}
{% for item in torrentGroup.relationships.tags %}
{% if item.attributes.tagType == "openai" and user.siteOptions.openaiContent %}

<tr>

<th class="openaiTorrentTag">{{ item.attributes.name }}</th>

<td class="right">
{% if can({"torrentGroups": "update", "tags": "delete"}) %}
	<a id="deleteGroupTag" class="conversationButton tooltip deleteGroupTag" title="delete" data-tagid={{ item.id }} data-groupid={{ torrentGroup.id }}>
		<i class="fa-thin fa-trash" data-tagid={{ item.id }} data-groupid={{ torrentGroup.id }}></i>
	</a>
{% endif %}

</td>
</tr>
{% endif %}

{% endfor %}

</table>

{# add new #}
<form method="post" action="/torrents.php?id=64&action=add_tag">

<select class="select" placeholder="e.g., {{ randomTag() }}" multiple>

{% for item in officialTags %}
<option name="tagIds[]" value="{{ item.id }}">{{ item.name }}</option>
{% endfor %}

</select>

<input type="submit" value="add tags" class="button button-primary">

</form>
</section>


{{ include("_base/linkObjects.twig") }}