{% extends "base.twig" %}


{% block content %}

<section>

{# page title #}
<h2>List of all site roles</h2>

<p>
    Below is a list of all the roles on the site.
    You can click on a role to update its permissions.
</p>

<p>
    <a href="/toolbox/permissionsManager/create" class="button button-primary">create a new role</a>
</p>

{# roles data #}
<table data-sortable>
    <thead>
        <tr>
            <th>Friendly name</th>
            <th>Permissions level</th>
            <th class="center">User count</th>

            <th class="center">Primary role</th>
            <th class="center">Secondary role</th>
            <th class="center">Default role</th>
            <th class="center">Staff role</th>

            <th class="center">Created at</th>
            <th class="center">Updated at</th>
        </tr>
    </thead>

    <tbody>
        {% for role in roles %}
            <tr>
                <td><a href="/toolbox/permissionsManager/{{ role.id }}">{{ role.friendlyName }}</a></td>
                <td class="center">{{ role.permissionsLevel|number_format }}</td>
                <td class="center">{{ role.userCount|number_format }}</td>

                <td class="center" data-value="{{ role.isPrimaryRole }}">{{ role.isPrimaryRole|boolval }}</td>
                <td class="center" data-value="{{ role.isSecondaryRole }}">{{ role.isSecondaryRole|boolval }}</td>
                <td class="center" data-value="{{ role.isDefaultRole }}">{{ role.isDefaultRole|boolval }}</td>
                <td class="center" data-value="{{ role.isStaffRole }}">{{ role.isStaffRole|boolval }}</td>

                <td class="center" data-value="{{ role.createdAt }}">
                    <span class="tooltip" title="{{ role.createdAt }}">{{ role.createdAt|relativeTime }}</span>
                </td>

                <td class="center" data-value="{{ role.createdAt }}">
                    <span class="tooltip" title="{{ role.updatedAt }}">{{ role.updatedAt|relativeTime }}</span>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

</section>

{% endblock %}


