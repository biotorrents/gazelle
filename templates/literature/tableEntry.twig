{##
 # academic paper table entry
 #}

<table class="torrentTable">
	<tr>
		<th>Literature info</th>
		<th>Links</th>
	</tr>

	{% for item in literature %}

	<tr>
		<td class="tableGroup">
			<div class="flexColumn">
				{# title link #}
				<a class="torrentTitle" href="/literature/{{ item.id }}">
					{{ item.attributes.title }}
				</a>

				<div class="flexRow">
				{# journal #}
				{% if item.attributes.journal %}
					<span class="tooltip journal" title="Journal">{{ item.attributes.journal|getJournalAsString }}</span>
				{% endif %}

			{# publicationDate #}
			{% if item.attributes.publicationDate %}
				<span class="tooltip publicationDate" title="Publication Date">{{ item.attributes.publicationDate }}</span>
			{% endif %}

			{# workgroup #}
			{#
			{% if item.attributes.workgroup %}
				<span class="tooltip workgroup" title="Workgroup">{{ item.attributes.workgroup|raw }}</span>
			{% endif %}
			#}
				</div>
			</div>
		
		<tr>
			{# title #}
			<td class="tableGroup" colspan="6">
			<div class="flexColumn">

		{# title link #}
		<a class="torrentTitle" href="/literature/{{ item.id }}">
			{{ item.attributes.title }}
		</a>

		<div class="flexRow">
			{# subject #}
			{% if item.attributes.subject %}
				<span class="tooltip subjectObject" title="Organism">{{ "<em>#{item.attributes.subject}</em>"|raw }}
					{# object #}
					{{ (item.attributes.object) ? item.attributes.object : "" }}
				</span>
			{% endif %}

			{# year #}
			{% if item.attributes.year %}
				<span class="tooltip year" title="Year">{{ item.attributes.year }}</span>
			{% endif %}

			{# identifier #}
			{% if item.attributes.identifier %}
				<span class="tooltip identifier" title="Identifier">{{ item.attributes.identifier }}</span>
			{% endif %}

			{# workgroup #}
			{% if item.attributes.workgroup %}
				<span class="tooltip workgroup" title="Workgroup">{{ item.attributes.workgroup|raw }}</span>
			{% endif %}

			{# location #}
			{% if item.attributes.location %}
				<span class="tooltip location" title="Location">{{ item.attributes.location|raw }}</span>
			{% endif %}
		</div>

</div>
	</td>
</tr>

{% endfor %}

</table>


