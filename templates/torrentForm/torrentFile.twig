{# torrentFile #}
<tr>
	<th>
		<label for="torrentFile" class="required">Torrent file</label>
	</th>

	<td>
		<input type="file" id="torrentFile" name="torrentFile" required>

		<aside>
			Set the private flag, e.g.,
			<span class="monospace">mktorrent -p -a {announce} {data}</span>
		</aside>
	</td>
</tr>
