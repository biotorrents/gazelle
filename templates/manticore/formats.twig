{##
 # formats
 #}

<tr id="formats">
	<th>Formats</th>
	<td>
		{# sequenceFormats #}
		<select id="sequenceFormats" name="formats[]" class="select" placeholder="Sequences" multiple>
            <option disabled>Nucleotides</option>
            {% for key, value in env.metadata.formats.nucleotides %}
	            <option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
		            {{ key }}
	            </option>
            {% endfor %}

            <option disabled>Proteins</option>
            {% for key, value in env.metadata.formats.proteins %}
	            <option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
		            {{ key }}
	            </option>
            {% endfor %}
		</select>

		{# imageFormats #}
		<select id="imageFormats" name="formats[]" class="select" placeholder="Images" multiple>
            <option disabled>Raster</option>
            {% for key, value in raster %}
	            <option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
		            {{ key }}
	            </option>
            {% endfor %}

            <option disabled>Vector</option>
            {% for key, value in vector %}
            	<option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
	            	{{ key }}
	            </option>
            {% endfor %}
		</select>

		{# otherFormats #}
		<select id="otherFormats" name="formats[]" class="select" placeholder="Other" multiple>
            <option disabled>Structured data/XML</option>
            {% for key, value in xmls %}
	            <option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
	            	{{ key }}
	            </option>
            {% endfor %}

            <option disabled>Plain text and binary</option>
            {% for key, value in extras %}
	            <option value="{{ key }}" {{ (key in manticore.terms.formats) ? "selected" : "" }}>
	            	{{ key }}
	            </option>
            {% endfor %}
		</select>

		{# archiveFormats: todo #}
		<select id="archiveFormats" name="archives[]" class="select" placeholder="Archives" multiple>
            {% for key, value in env.metadata.formats.archives %}
	            <option value="{{ key }}" {{ (key in manticore.terms.archives) ? "selected" : "" }}>
	            	{{ key }}
	            </option>
            {% endfor %}
		</select>
	</td>
</tr>