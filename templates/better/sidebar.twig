<h3>Actions</h3>

<form>
    <a href="/better/single-seeder" {{ (currentPage == "single-seeder") ? "class='button button-primary'" : "class='button'" }}>single seeder</a>

    <a href="/better/missing-citations" {{ (currentPage == "missing-citations") ? "class='button button-primary'" : "class='button'" }}>missing citations</a>

    <a href="/better/missing-pictures" {{ (currentPage == "missing-pictures") ? "class='button button-primary'" : "class='button'" }}>missing pictures</a>

    <a href="/better/bad-tags" {{ (currentPage == "bad-tags") ? "class='button button-primary'" : "class='button'" }}>bad tags</a>

    <a href="/better/bad-folders" {{ (currentPage == "bad-folders") ? "class='button button-primary'" : "class='button'" }}>bad folders</a>

    <hr>

    {% if snatchedOnly %}
        <a href="/better/{{ currentPage }}" class="button">show all torrents</a>
    {% else %}
        <a href="/better/{{ currentPage }}?snatches=true" class="button">show snatched torrents</a>
    {% endif %}

    <a href="/better" class="button button-orange">back to index</a>
</form>
