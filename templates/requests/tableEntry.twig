{##
 # search results table entry
 #}

{# request entry (similar to torrent groups) #}
<tr>

	{# category icon #}
	<td class="center">
		{{item.attributes.categoryId|categoryIcon }}
	</td>


	{# title #}
	<td class="tableGroup">
<div class="flexColumn">

		{# title link #}
		<a class="torrentTitle" href="/requests/{{ item.id }}" {# open tag #}

    {% if item.attributes.picture %}
        data-cover="{{ item.attributes.picture }}" {# open tag #}
    {% endif %}

    dir="ltr">
			{{ item.attributes.title|raw }}
		</a>

		<div class="flexRow">
			{# subject #}
			{% if item.attributes.subject %}
				<span class="tooltip subjectObject" title="Organism">{{ "<em>#{item.attributes.subject}</em>"|raw }}
					{# object #}
					{{ (item.attributes.object) ? item.attributes.object : "" }}
				</span>
			{% endif %}

			{# identifier #}
			{% if item.attributes.identifier %}
				<span class="tooltip identifier" title="Identifier">{{ item.attributes.identifier }}</span>
			{% endif %}

			{# workgroup #}
			{#
			{% if item.attributes.workgroup %}
				<span class="tooltip workgroup" title="Workgroup">{{ item.attributes.workgroup|raw }}</span>
			{% endif %}
			#}

			{# location #}
			{#
			{% if item.attributes.location %}
				<span class="tooltip location" title="Location">{{ item.attributes.location|raw }}</span>
			{% endif %}
			#}
		</div>

		{# tags #}
		
		{% if item.relationships.tags is not empty %}
			<div class="tooltip tagList" title="tags">{{ item.relationships.tags|stringifyTags }}</div>
		{% endif %}
		

		{# creators #}
		{#
		{% if item.attributes.Artists is not empty %}
			<div class="tooltip creatorList" title="Creators">{{ displayCreators(item.attributes.Artists)|raw }}</div>
		{% endif %}
		#}

		{#
		{% if extra_info|default(false) %}
		  <br>
		  <span class="torrent_info">
		    {{ extra_info|raw }}
		  </span>
		{% endif %}
		#}

</div>
	</td>

		{# createdAt #}
	<td class="center nobr" title="{{ item.attributes.createdAt }}">
  {{ item.attributes.createdAt|relativeTime }}
  </td>

		{# lastVote #}
	<td class="center nobr" title="{{ item.attributes.lastVote }}">
  {{ item.attributes.lastVote|relativeTime }}
  </td>

		{# filledAt #}
		{% if item.attributes.filledAt is not empty %}
	<td class="center nobr" title="{{ item.attributes.filledAt }}">
  {{ item.attributes.filledAt|relativeTime }}
  </td>
		{% else %}
	<td class="center nobr" title="Not filled">
	❌
	  </td>
		{% endif %}



	{# timeAdded # }
	<td></td>


	{# data size # }
	<td></td>


	{# file count # }
	<td></td>


	{# seeders # }
	<td></td>


	{# leechers # }
	<td></td>


	{# snatches # }
	<td></td>
  #}

</tr>

