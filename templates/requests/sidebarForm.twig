{# actions #}
<section>
	<h3>Actions</h3>

	<form>
		<input type="text" id="doiNumberInput" placeholder="e.g., 10.1128/mr.49.3.181-213.1985">

		<a id="doiNumberAutofill" class="button button-primary">
			autofill by doi
			<span id="autofillLoader" class="loaderLight"></span>
		</a>

		<hr/>

		<a href="/rules/requests" target="_blank" class="button ">request rules</a>

		<a href="/wiki/categories" target="_blank" class="button ">categories wiki</a>

		<aside>
			Please make sure to validate your request and consult the rules.
			Not doing so may result in a
			<span class="error">warning</span>!
		</aside>

		<hr/>

		<a href="/torrents" target="_blank" class="button button-orange">search torrents</a>

		<aside>
			Please search for the torrent before uploading a request.
			There's a chance the data you're looking for is already available.
		</aside>

	</form>
</section>
