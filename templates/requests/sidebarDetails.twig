{# cover art #}
<section>

	{% if request.attributes.picture is not empty %}
		{% set uri = processImage(request.attributes.picture, "thumb") %}
	{% else %}
		{% set uri = processImage("#{env.staticServer}/images/noartwork.webp", "thumb") %}
	{% endif %}

	<figure id="groupPicture" class="box_image box_image_albumart box_albumart">
		<img src="{{ uri }}" lightbox-img="{{ uri }}" alt="{{ request.attributes.title }}" title="{{ request.attributes.title }}">
	</figure>

</section>


{# actions #}
<section>

	<h3>Actions</h3>

	{# vote #}
	<form method="post">
	    {{ form_token(request.server.REQUEST_URI) }}

		<input type="number" id="voteAmount" name="voteAmount" min="1" placeholder="Vote on this request">

		<select id="voteUnits" name="voteUnits" class="select">
			<option value="MiB">MiB</option>
			<option value="GiB">GiB</option>
		</select>

		<input type="submit" id="submitVote" name="submitVote" value="add to the bounty" class="button-primary">

		<span>
			These units are in base 2, not base 10, e.g., there are 1,024 MiB in 1 GiB.
			<strong>The system deducts 20% as a tax.</strong>
		</span>

		<hr>

		{# fill request #}
		{% if can({"torrents": "create"}) %}
			<input type="text" id="fillRequest" name="fillRequest" placeholder="Fill this request">

			<input type="submit" id="fill" name="fill" value="fill request" class="button-green">

			<span>This should be the permalink of a torrent you recently uploaded.</span>

			<hr>
		{% endif %}

		{# edit request #}
		{% if can({"requests": "updateAny"}) %}
			<a class="button button-orange" href="/requests/edit/{{ request.id }}">edit request</a>
		{% endif %}

		{# report #}
		<a class="button button-red" href="/reports.php?action=report&type=request&id={{ request.id }}">report request</a>

		<hr>

		{# toggle bookmark #}
		{% if isBookmarked %}
			<a class="button button-red" id="toggleRequestBookmark" data-userid="{{ user.core.id }}" data-requestid="{{ request.id }}">remove bookmark</a>
		{% else %}
			<a class="button button-orange" id="toggleRequestBookmark" data-userid="{{ user.core.id }}" data-requestid="{{ request.id }}">add bookmark</a>
		{% endif %}

		{# toggle subscription #}
		{% if isSubscribed %}
			<a class="button button-red" id="toggleRequestSubscription" data-userid="{{ user.core.id }}" data-requestid="{{ request.id }}">remove subscription</a>
		{% else %}
			<a class="button button-orange" id="toggleRequestSubscription" data-userid="{{ user.core.id }}" data-requestid="{{ request.id }}">add subscription</a>
		{% endif %}
	</form>

</section>


