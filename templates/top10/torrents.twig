	{# torrentData #}
	{% if torrentData is not empty %}
	<section>
		<h3>{{ limit }} most transferred torrents</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": torrentData}) }}
	</section>
	{% endif %}

{% endblock %}


{% block sidebar %}

	{% include "top10/sidebar.twig" %}

{% endblock %}
