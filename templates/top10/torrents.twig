	</section>
	{% endif %}

	{# yearlyTorrents #}
	{% if yearlyTorrents is not empty %}
	<section>
		<h3>{{ limit }} most active yearly uploads</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": yearlyTorrents}) }}
	</section>
	{% endif %}

	{# overallTorrents #}
	{% if overallTorrents is not empty %}
	<section>
		<h3>{{ limit }} most active overall uploads</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": overallTorrents}) }}
	</section>
	{% endif %}

	{# torrentSeeders #}
	{% if torrentSeeders is not empty %}
	<section>
		<h3>{{ limit }} best seeded torrents</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": torrentSeeders}) }}
	</section>
