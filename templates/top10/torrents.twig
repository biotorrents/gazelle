	{# torrentSnatches #}
	{% if torrentSnatches is not empty %}
	<section>
		<h3>{{ limit }} most snatched torrents</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": torrentSnatches}) }}
