{% extends "base.twig" %}

{% block content %}

	<h2>Top torrents</h2>

	{# dailyTorrents #}
	{% if dailyTorrents is not empty %}
	<section>
		<h3>{{ limit }} most active daily uploads</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": dailyTorrents}) }}
	</section>
	{% endif %}

	{# weeklyTorrents #}
	{% if weeklyTorrents is not empty %}
	<section>
		<h3>{{ limit }} most active weekly uploads</h3>
		{{ include("tables/torrentGroupsWithoutTorrents.twig", {"torrentGroups": weeklyTorrents}) }}
	</section>
	{% endif %}

	{# monthlyTorrents #}
	{% if monthlyTorrents is not empty %}
	<section>
		<h3>{{ limit }} most active monthly uploads</h3>
