<table>
    <thead>
	        {# literature info #}
	        <th>Literature&nbsp;info</th>
        </tr>
    </thead>

    <tbody>
        {% for item in literature %}
            <tr>
	            {# title #}
	            <td class="tableGroup">
		            <div class="flexColumn">

		                {# title link #}
		                <a class="torrentTitle" href="/literature/{{ item.id }}">
			                {{ item.attributes.title }}
		                </a>

		                <div class="flexRow">
			                {# doi #}
			                {% if item.attributes.doi is not empty %}
				                <span class="tooltip doi" title="DOI">{{ item.attributes.doi }}</span>
			                {% endif %}

			                {# journal #}
			                {% if item.attributes.journal is not empty %}
				                <span class="tooltip journal" title="Journal">{{ item.attributes.journal.name }}</span>
			                {% endif %}

			                {# publicationDate #}
			                {% if item.attributes.publicationDate is not empty %}
				                <span class="tooltip publicationDate" title="Publication date">{{ item.attributes.publicationDate }}</span>
			                {% endif %}

							{# sci-hub #}
			                {% if item.attributes.doi is not empty %}
				                <a href="{{ sciHubLink(item.attributes.doi) }}" target="_blank" class="tooltip sci-hub external" title="Sci-Hub">Sci-Hub</a>
			                {% endif %}
		                </div>

		                {# creators #}
                        {#
		                {% if item.attributes.Artists is not empty %}
			                <div class="tooltip creatorList" title="Creators">{{ displayCreators(item.attributes.Artists)|raw }}</div>
		                {% endif %}
		                #}

						{# tl;dr: no tooltip #}
		                {% if item.attributes.tldr is not empty %}
			                <p class="tldr faded ai">{{ item.attributes.tldr.text }}</p>
		                {% endif %}
                    </div>
	            </td>
            </tr>
        {% endfor %}

        {# semantic scholar ajax search #}
        <tr>
            <td>
                {#
                <select id="searchSemanticScholar" placeholder="Find with Semantic Scholar" autocomplete="off">
		        </select>
                #}
                <input type="text" id="searchSemanticScholar" placeholder="Find with Semantic Scholar" autocomplete="off">
                  <input type="hidden" id="literatureIds" name="literatureIds" value=""> 
            </td>
    </tbody>
</table>

<script src="/js/literature.js"></script>