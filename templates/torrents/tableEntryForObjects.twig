{##
 # torrent group table entry
 #}

<tr>

	{# category icon #}
	<td class="center">
		{{group.attributes.categoryId|categoryIcon }}
	</td>


	{# title #}
	<td class="tableGroup" colspan="6">
		<div class="flexColumn">

		{# title link #}
		<a class="torrentTitle" href="/torrent-groups/{{ group.id }}" {# open tag #}

    	{% if group.attributes.picture %}
        	data-cover="{{ group.attributes.picture }}" {# open tag #}
    	{% endif %}

    	dir="ltr">
			{{ group.attributes.title|raw }}
		</a>

		<div class="flexRow">
			{# subject #}
			{% if group.attributes.subject %}
				<span class="tooltip subjectObject" title="Organism">{{ "<em>#{group.attributes.subject}</em>"|raw }}
					{# object #}
					{{ (group.attributes.object) ? group.attributes.object : "" }}
				</span>
			{% endif %}

			{# year #}
			{% if group.attributes.year %}
				<span class="tooltip year" title="Year">{{ group.attributes.year }}</span>
			{% endif %}

			{# identifier #}
			{% if group.attributes.identifier %}
				<span class="tooltip identifier" title="Identifier">{{ group.attributes.identifier }}</span>
			{% endif %}

			{# workgroup #}
			{% if group.attributes.workgroup %}
				<span class="tooltip workgroup" title="Workgroup">{{ group.attributes.workgroup|raw }}</span>
			{% endif %}

			{# location #}
			{% if group.attributes.location %}
				<span class="tooltip location" title="Location">{{ group.attributes.location|raw }}</span>
			{% endif %}
		</div>

		{# tags #}
		{% if group.attributes.tags is not empty %}
			<div class="tooltip tagList" title="Tags">{{ group.attributes.tags|join(", ") }}</div>
		{% endif %}

		{# creators # }
		{% if group.attributes.Artists is not empty %}
			<div class="tooltip creatorList" title="Creators">{{ displayCreators(group.attributes.Artists)|raw }}</div>
		{% endif %}
		#}

</div>
	</td>
</tr>


{# individual torrents # }
{% for torrent in group.relationships.torrents %}
<tr>

	{# category icon # }
<td class="center">
<a href="/torrents.php?id={{ group.id }}#torrentId-{{ torrent.id }}">Go&nbsp;»</a>
</td>


	{# title # }
	<td class="flexRow">

  {# platform # }
  {% if torrent.attributes.platform %}
    <span class="tooltip platform" title="Platform">{{ torrent.attributes.platform }}</span>
  {% endif %}

  {# format # }
  {% if torrent.attributes.format %}
    <span class="tooltip format" title="Format">{{ torrent.attributes.format }}</span>
  {% endif %}

  {# version # }
  {% if torrent.attributes.Version %}
    <span class="tooltip version" title="Version">{{ torrent.attributes.Version }}</span>
  {% endif %}

  {# scope # }
  {% if torrent.attributes.scope %}
    <span class="tooltip scope" title="Scope">{{ torrent.attributes.scope }}</span>
  {% endif %}

  {# archive # }
  {% if torrent.attributes.archive %}
    <span class="tooltip archive" title="Archive">{{ torrent.attributes.archive }}</span>
  {% endif %}

  {# license # }
  {% if torrent.attributes.license %}
    <span class="tooltip license" title="License">{{ torrent.attributes.license }}</span>
  {% endif %}

  {# alignment # }
  {% if torrent.attributes.alignment %}
    <span title="Alignment" class="tooltip good">Aligned</span>
  {% else %}
      <span title="Alignment" class="tooltip bad">Not aligned</span>
  {% endif %}

</td>


	{# createdAt # }
	<td class="nobr">
  		<span class="tooltip" title="{{ torrent.attributes.createdAt }}">{{ torrent.attributes.createdAt|relativeTime }}</span>
  </td>


	{# dataSize # }
	<td class="nobr">
  {{ torrent.attributes.dataSize|get_size }}
  </td>

	{# seederCount # }
	<td class="nobr">
    {{ torrent.attributes.seederCount|number_format }}
  </td>


	{# leecherCount # }
	<td class="nobr">
    {{ torrent.attributes.leecherCount|number_format }}
</td>


	{# snatchCount # }
	<td class="nobr">
    {{ torrent.attributes.snatchCount|number_format }}
</td>
</tr>
{% endfor %}
#}