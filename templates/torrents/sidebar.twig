</section>


{# actions #}
<section>
	<h3>Actions</h3>

	<form>
		{# download #}
		<a class="button button-primary" href="/torrents.php?action=download&torrentId={{ torrent.id }}&torrent_pass={{ user.extra.torrent_pass}}">download</a>

		{# freeleech token #}
		{% if torrent.canUseToken %}
			<a class="button button-purple useFreeleechToken" href="/torrents.php?action=download&torrentId={{ torrent.id }}&torrent_pass={{ user.extra.torrent_pass}}&usetoken=1">freeleech</a>
		{% endif %}

		{# update #}
		{% if can({"torrents": "update"}) or torrent.attributes.userId == user.core.id %}
			<a class="button button-orange" href="/torrents/{{ torrent.id }}/edit">edit</a>
		{% endif %}

		{# report #}
		<a class="button button-red" href="/reportsv2.php?action=report&id={{ torrent.id }}">report</a>

		{# delete #}
		{% if can({"torrents": "delete"}) or torrent.attributes.userId == user.core.id %}
			<a class="button button-red" href="/torrents/{{ torrent.id }}/delete">delete</a>
		{% endif %}
	</form>

</section>


{# tracker #}
<section>
	<h3>Tracker data</h3>

	<table class="compact">

		{# fileCount #}
		<tr>
			<th>File count</th>
			<td>{{ torrent.attributes.fileCount|number_format }}</td>
		</tr>

		{# dataSize #}
		<tr>
			<th>Data size</th>
			<td>{{ torrent.attributes.dataSize|get_size }}</td>
		</tr>

		{# leecherCount #}
		<tr>
			<th>Leechers</th>
			<td>{{ torrent.attributes.leecherCount|number_format }}</td>
		</tr>

		{# seederCount #}
		<tr>
			<th>Seeders</th>
			<td>{{ torrent.attributes.seederCount|number_format }}</td>
		</tr>

		{# lastAction #}
		<tr>
			<th>Last action</th>
			<td>{{ torrent.attributes.lastAction|relativeTime }}</td>
		</tr>

</table>

</section>


  	{# fileList #}
   {% if torrent.attributes.fileList is not empty %}
	<section>
		<h3>File list</h3>

    <select class="select" multiple placeholder="Search the file list">
      {% for file in torrent.attributes.fileList %}
      <option value="{{ file.name }}">{{ file.name }}</option>
      {% endfor %}
    </select>
  {% endif %}

	</section>


