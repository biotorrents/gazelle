{# cover art #}
<section>

	{% if user.siteOptions.coverArtTorrents %}
		{% set uri = processImage(torrentGroup.attributes.picture, "thumb") %}
	{% else %}
		{% set uri = processImage("#{env.staticServer}/images/noartwork.webp", "thumb") %}
	{% endif %}

	<figure id="groupPicture" class="box_image box_image_albumart box_albumart">
		<img src="{{ uri }}" lightbox-img="{{ uri }}" alt="{{ torrentGroup.attributes.title }}" title="{{ torrentGroup.attributes.title }}">
	</figure>

</section>


{# actions #}
<section>
	<h3>Actions</h3>

	<form>
		{# download #}
		<a class="button button-primary" href="/torrents.php?action=download&torrentId={{ torrent.id }}&torrent_pass={{ user.extra.torrent_pass}}">download</a>

		{# freeleech token #}
		{% if canUseToken(torrent.id) %}
			<a class="button button-purple useFreeleechToken" href="/torrents.php?action=download&torrentId={{ torrent.id }}&torrent_pass={{ user.extra.torrent_pass}}&usetoken=1">freeleech</a>
		{% endif %}

		{# update #}
		{% if can({"torrents": "updateAny"}) or torrent.attributes.userId == user.core.id %}
			<a class="button button-orange" href="/torrents.php?action=edit&id={{ torrent.id }}">update</a>
		{% endif %}

		{# report #}
		<a class="button button-red" href="/reportsv2.php?action=report&id={{ torrent.id }}">report</a>

		{# delete #}
		{% if can({"torrents": "deleteAny"}) or torrent.UserID == user.core.id %}
			<a class="button button-red" href="/torrents.php?action=delete&torrentid={{ torrent.id }}">delete</a>
		{% endif %}
	</form>

</section>


{# tracker #}
<section>
	<h3>Tracker</h3>

	<table class="compact">

		{# fileCount #}
		<tr>
			<th>fileCount</th>
			<td>{{ torrent.attributes.fileCount }}</td>
		</tr>

		{# dataSize #}
		<tr>
			<th>dataSize</th>
			<td>{{ torrent.attributes.dataSize }}</td>
		</tr>

		{# leecherCount #}
		<tr>
			<th>leecherCount</th>
			<td>{{ torrent.attributes.leecherCount }}</td>
		</tr>

		{# seederCount #}
		<tr>
			<th>seederCount</th>
			<td>{{ torrent.attributes.seederCount }}</td>
		</tr>

		{# lastAction #}
		<tr>
			<th>fileCount</th>
			<td>{{ torrent.attributes.lastAction }}</td>
		</tr>

</table>

</section>



