{# cover art #}
<section>

	{% if user.siteOptions.coverArtTorrents %}
		{% set uri = processImage(torrentGroup.attributes.picture, "thumb") %}
	{% else %}
		{% set uri = processImage("#{env.staticServer}/images/noartwork.webp", "thumb") %}
	{% endif %}

<a href="#img1">
  <img src="{{ uri }}">
</a>

<!-- lightbox container hidden with CSS -->
<a href="#_" class="lightbox" id="img1">
  <img src="{{ uri }}">
</a>
