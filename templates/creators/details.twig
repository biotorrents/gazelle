{% extends "base.twig" %}

{% block content %}

	<h2>{{ creator.attributes.name }}</h2>

	{# essential details table #}
	<section>
		<table>

      		{# orcid #}
			{% if creator.attributes.orcid is not empty %}
				<tr>
					<th><span class="orcid nobr">ORCiD</span></th>
					<td><a href="{{ creator.attributes.orcid }}" target="_blank" class="external monospace">{{ creator.attributes.orcid }}</a></td>
				</tr>
			{% endif %}

			{# openAlexId #}
			{% if creator.attributes.openAlexId is not empty %}
				<tr>
					<th><span class="openAlexId nobr">OpenAlex</span></th>
					<td><a href="{{ creator.attributes.openAlexId }}" target="_blank" class="external monospace">{{ creator.attributes.openAlexId }}</a></td>
				</tr>
			{% endif %}

      		{# semanticScholarId #}
			{% if creator.attributes.semanticScholarId is not empty %}
				<tr>
					<th><span class="semanticScholarId nobr">Semantic Scholar</span></th>
					<td><a href="https://www.semanticscholar.org/author/{{ creator.attributes.semanticScholarId }}" target="_blank" class="external monospace">{{ creator.attributes.semanticScholarId }}</a></td>
				</tr>
			{% endif %}


      		{# homepage #}
			{% if creator.attributes.homepage is not empty %}
				<tr>
					<th><span class="homepage nobr">Homepage</span></th>
					<td><a href="" target="_blank" class="external monospace">{{ creator.attributes.homepage }}</a></td>
				</tr>
			{% endif %}

			{# affiliations #}
			{#
			{% if creator.attributes.affiliations is not empty %}
				<tr>
					<th><span class="affiliations nobr">Affiliations</span></th>
					<td>{{ creator.attributes.affiliations|join(", ") }}</td>
				</tr>
			{% endif %}
			#}

      		{# aliases #}
			{#
			{% if creator.attributes.aliases is not empty %}
				<tr>
					<th><span class="aliases nobr">Aliases</span></th>
					<td>{{ creator.attributes.aliases|join(", ") }}</td>
				</tr>
			{% endif %}
			#}

			{# hIndex #}
			{% if creator.attributes.hIndex is not empty %}
				<tr>
					<th><span class="hIndex nobr">h-index</span></th>
					<td>{{ creator.attributes.hIndex|number_format }}</td>
				</tr>
			{% endif %}

      		{# paperCount #}
			{% if creator.attributes.paperCount is not empty %}
				<tr>
					<th><span class="paperCount nobr">Publications</span></th>
					<td>{{ creator.attributes.paperCount|number_format }}</td>
				</tr>
			{% endif %}

      		{# citationCount #}
			{% if creator.attributes.citationCount is not empty %}
				<tr>
					<th><span class="citationCount nobr">Citations</span></th>
					<td>{{ creator.attributes.citationCount|number_format }}</td>
				</tr>
			{% endif %}

		</table>
	</section>


	{# biography #}
	{% if creator.attributes.biography is not empty %}
		<section>
			<h3>Biography</h3>
			{{ creator.attributes.biography|parse }}
		</section>
	{% endif %}


	{# torrent groups #}
	{% if creator.torrentGroups is not empty %}
		<section>
			<h3>Torrent groups</h3>
			{{ include("tables/torrentGroups.twig", {"torrentGroups": creator.torrentGroups}) }}
		</section>
	{% endif %}

	{# literature #}
	{% if creator.literature is not empty %}
		<section>
			<h3>Literature</h3>
			{{ include("tables/literature.twig", {"literature": creator.literature}) }}
		</section>
	{% endif %}


  	{# countsByYear #}
	{% if creator.attributes.countsByYear is not empty %}
		{{ include("stats/countsByYear.twig", { "data": creator.attributes.countsByYear|json_encode, "key": "cited_by_count" } )}}
	{% endif %}


	{# conversation #}
	{% if enableConversation and conversation %}
    	{{ include("_base/conversation.twig") }}
	{% endif %}

{% endblock %}


{% block sidebar %}

	{{ include("creators/sidebar.twig") }}

{% endblock %}
