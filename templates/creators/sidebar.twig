{# picture #}
<section>

	{% if creator.attributes.picture %}
		{% set uri = processImage(creator.attributes.picture, "thumb") %}
	{% else %}
		{% set uri = processImage("/images/avatars/default.webp", "thumb") %}
	{% endif %}

	<figure id="groupPicture" class="box_image box_image_albumart box_albumart">
		<img src="{{ uri }}" lightbox-img="{{ uri }}" alt="{{ creator.attributes.name }}" title="{{ creator.attributes.name }}">
	</figure>
</section>


{# actions #}
<section>
	<h3>Actions</h3>

	<form>
		{# add new request #}
		{% if can({"requests": "create"}) %}
			<a class="button button-primary" href="/requests/new">new request</a>
		{% endif %}

		{# edit description #}
		{% if can({"creators": "update"}) %}
			<a class="button button-orange" href="/creators/edit/{{ creator.id }}">edit description</a>
		{% endif %}

		<hr>

		{# toggle bookmark #}
		{% if isBookmarked %}
			<a class="button button-red" id="toggleCreatorBookmark" data-userid="{{ user.core.id }}" data-creatorid="{{ creator.id }}">remove bookmark</a>
		{% else %}
			<a class="button button-orange" id="toggleCreatorBookmark" data-userid="{{ user.core.id }}" data-creatorid="{{ creator.id }}">add bookmark</a>
		{% endif %}

		{# toggle subscription #}
		{% if isSubscribed %}
			<a class="button button-red" id="toggleCreatorSubscription" data-userid="{{ user.core.id }}" data-creatorid="{{ creator.id }}">remove subscription</a>
		{% else %}
			<a class="button button-orange" id="toggleCreatorSubscription" data-userid="{{ user.core.id }}" data-creatorid="{{ creator.id }}">add subscription</a>
		{% endif %}
	</form>
</section>


{# add related items #}
