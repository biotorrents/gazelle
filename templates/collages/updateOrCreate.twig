{% extends "base.twig" %}

{% block content %}

	<h2>{{ pageTitle|raw }}</h2>

  {# collage form #}
  <section>
    <h3 class="hidden">collageForm</h3>

{# any errors? #}
    {% if errorMessage %}
     <p class="error">{{ errorMessage }}</p>
    {% endif %}

{# admonition #}
    <p>
      Please consult the
      <a href="/rules/collages">collage rules</a>
      before using this form.
      This page has helpful guidelines for using the collage system.
      Thanks for contributing to the site's data ecosystem.
    </p>

    
    <form name="collage" method="post">

      {# hidden fields #}
      {{ form_token(http.server.REQUEST_URI) }}
		  <input type="hidden" name="id" value={{ collage.id }}>
		  <input type="hidden" name="userId" value="{{ user.core.id }}">

      {# visible fields #}
			<table>

      {# title #}
	    <tr>
		    <th>
          <label for="title">Title</label>
		    </th>

		    <td>
			    <input type="text" id="title" name="title" maxlength="128" placeholder="The collage's title" value="{{ (collage) ? collage.attributes.title : "" }}">
		    </td>
	    </tr>

      {# category #}
	    <tr>
		    <th>
          <label for="categoryId">Category</label>
		    </th>

		    <td>
          <select name="categoryId">
          {% for key, value in categories %}
            <option value="{{ key }}" {{ (collage and collage.attributes.categoryId == key) ? " selected" : "" }}>{{ value }}</option>
          {% endfor %}
          </select>

          {# todo: this is hardcoded #}
          <br><br>
          <ul>
            <li>
              <strong>Personal</strong> &mdash; A collage that appears on your profile page
            </li>

            <li>
              <strong>Thematic</strong> &mdash; A collage with thematically grouped torrents
            </li>

            <li>
              <strong>Staff Picks</strong> &mdash; A list of staff recommendations for special occasions
            </li>

            <li>
              <strong>Group Picks</strong> &mdash; A collage that appears on your profile page
            </li>
          </ul>

		    </td>
	    </tr>

      {# description #}
	    <tr>
		    <th>
          <label for="description">Description</label>
		    </th>

		    <td>
          {% set variables = {"id": "description", "name": "description", "placeholder": "Detailed description of the collage's content and purpose", "value": (collage) ? collage.attributes.description : "", "required": true} %}
			    {% include "_base/textarea.twig" with variables %}
		    </td>
	    </tr>

      {# tags #}
			<tr>
				<th>Tags</th>
				<td>
					<select id="tags" name="tags[]" class="select" placeholder="Add or remove tags" multiple>
						{% for item in officialTags %}
							<option value="{{ item }}" {{ (item in collage.attributes.tags) ? "selected" : "" }}>
								{{ item }}
							</option>
						{% endfor %}
					</select>
					
				</td>
			</tr>

      {# max groups #}
      <tr>
				<th>Max groups</th>
				<td>
          <input type="number" name="maximumGroups" value="{{ (collage and collage.attributes.maximumGroups) ? collage.attributes.maximumGroups : 0 }}">
				</td>
			</tr>

      {# max groups per user #}
      <tr>
				<th>Max groups per user</th>
				<td>
          <input type="number" name="groupsPerUser" value="{{ (collage and collage.attributes.groupsPerUser) ? collage.attributes.groupsPerUser : 0 }}">
				</td>
			</tr>

      {# locked #}
      <tr>
				<th>Lock this collage?</th>
				<td>
          <input type="checkbox" name="isLocked" value="1" {{ (collage and collage.attributes.isLocked) ? "checked" : "" }}>
				</td>
			</tr>
  </table>

<p class="center">
{# update button #}
      {% if isUpdate %}
            <input type="submit" class="button-orange" value="update">

{# create button #}
      {% else %}
            <input type="submit" class="button-primary" value="create">
      {% endif %}
</p>

    </form>

  </section>

{% endblock %}